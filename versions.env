# The one place a version is written.
#
# Every target builds these exact sources, so a subtitle rendered on the web,
# the desktop, a phone and a television came out of the same code. A per-platform
# package manager cannot promise that — Homebrew, apt, an Android binding and an
# npm wasm blob drift apart and each falls short somewhere different.
#
# Digests are the point. A tarball fetched without one is a build that changes
# under you.

LIBASS_VERSION=0.17.3
LIBASS_SHA256=da7c348deb6fa6c24507afab2dee7545ba5dd5bbf90a137bfe9e738f7df68537

# From the GitHub mirror, not savannah: savannah refused every connection from
# here, and a build that only works where savannah is reachable is the kind of
# dependence this repo exists to remove.
FREETYPE_VERSION=2.13.3
FREETYPE_SHA256=bc5c898e4756d373e0d991bab053036c5eb2aa7c0d5c67e8662ddc6da40c4103

FRIBIDI_VERSION=1.0.16
FRIBIDI_SHA256=1b1cde5b235d40479e91be2f0e88a309e3214c8ab470ec8a2744d82a5a9ea05c

HARFBUZZ_VERSION=10.1.0
HARFBUZZ_SHA256=6ce3520f2d089a33cef0fc48321334b8e0b72141f6a763719aaaecd2779ecb82
