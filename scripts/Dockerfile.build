#
# The release runner's toolchain, pinned to the same ubuntu the matrix uses, so
# a build that passes here passes there. Every package in this list is one the
# workflow installs; adding one here without adding it there would make local
# green mean nothing.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -y && apt-get install -y --no-install-recommends \
        meson ninja-build nasm pkg-config \
        build-essential curl ca-certificates xz-utils \
        mingw-w64 python3 nodejs git \
    && rm -rf /var/lib/apt/lists/*

# emsdk, not the distro's emscripten.
#
# apt ships 3.1.6 with a read-only cache, and its sanity check fails before any
# of our code compiles: "Executables created by c compiler emcc are not
# runnable". CI uses setup-emsdk, so taking the distro package here would mean
# local and CI ran different compilers — which is the drift this repo exists to
# end, reproduced inside its own tooling.
#
# The version comes from versions.env, the same line the workflow reads, so
# the image and CI cannot pin two different compilers. "latest" is not a pin:
# it moved from 6.0.6 to 6.0.10 between two green builds without anyone
# choosing it.
COPY versions.env /tmp/versions.env
RUN . /tmp/versions.env \
    && git clone --depth 1 https://github.com/emscripten-core/emsdk.git /opt/emsdk \
    && /opt/emsdk/emsdk install "$EMSCRIPTEN_VERSION" \
    && /opt/emsdk/emsdk activate "$EMSCRIPTEN_VERSION"

ENV PATH="/opt/emsdk:/opt/emsdk/upstream/emscripten:/opt/emsdk/node/*/bin:${PATH}"
ENV EM_CACHE=/tmp/emcache
