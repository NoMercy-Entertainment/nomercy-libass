# The one place a version is written.
#
# Every target builds these exact sources, so a subtitle rendered on the web,
# the desktop, a phone and a television came out of the same code. A per-platform
# package manager cannot promise that — Homebrew, apt, an Android binding and an
# npm wasm blob drift apart and each falls short somewhere different.
#
# Digests are the point. A tarball fetched without one is a build that changes
# under you.

# 0.17.5, matching what the Apple XCFramework already ships. Two versions under
# one "single origin" is not one origin — the desktop and the phone would have
# been built from 0.17.3 while iOS ran 0.17.5, which is the drift this repo
# exists to end.
LIBASS_VERSION=0.17.5
LIBASS_SHA256=caab4b993dd7be6187c55623b789ed75dddefea6e65938af134637c732fe094a

# Our number, not upstream's.
#
# LIBASS_VERSION says which sources were built. This says which BUILD of them
# is published, and it exists because a published archive must never change
# under a consumer: nomercy-player-core-kmp pins every payload by digest, and
# re-uploading different bytes under a tag that already shipped is exactly the
# "a tarball fetched without one is a build that changes under you" this file
# opens by warning about.
#
# Bump it when the sources are the same and the output is not -- a link flag, a
# packaging change, a fix to what goes in the archive. Revision 1 is the first:
# the windows-x64 payload imported libgcc_s_seh-1.dll and loaded only on
# machines that happened to have a copy.
#
# Empty means no suffix, so the scheme costs nothing until it is used.
LIBASS_REVISION=2
LIBASS_PAYLOAD_VERSION="${LIBASS_VERSION}${LIBASS_REVISION:+-$LIBASS_REVISION}"

# From the GitHub mirror, not savannah: savannah refused every connection from
# here, and a build that only works where savannah is reachable is the kind of
# dependence this repo exists to remove.
FREETYPE_VERSION=2.13.3
FREETYPE_SHA256=bc5c898e4756d373e0d991bab053036c5eb2aa7c0d5c67e8662ddc6da40c4103

FRIBIDI_VERSION=1.0.16
FRIBIDI_SHA256=1b1cde5b235d40479e91be2f0e88a309e3214c8ab470ec8a2744d82a5a9ea05c

HARFBUZZ_VERSION=10.1.0
HARFBUZZ_SHA256=6ce3520f2d089a33cef0fc48321334b8e0b72141f6a763719aaaecd2779ecb82

# The compiler is a source too.
#
# scripts/Dockerfile.build and the release workflow both installed emsdk
# "latest", so a rebuild could take a compiler nobody had tested the worker
# against, and the image and CI could disagree with each other. The worker
# glue hands ass_render_frame its 64-bit timestamp as a BigInt, which is the
# emscripten convention since 4.0.0; a compiler that chose differently would
# throw at the first frame and leave the overlay blank.
#
# 6.0.10 is what the last green wasm build resolved "latest" to (release run
# of 2026-09-29). scripts/check-emsdk-pin.sh refuses anything that is not an
# exact version, older than 4.0.0, or read from anywhere but here.
EMSCRIPTEN_VERSION=6.0.10
